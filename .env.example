# Google Gemini API Key
GOOGLE_API_KEY=your_gemini_api_key_here

# ADK Configuration
ADK_MODEL=gemini-2.5-flash
ADK_ENVIRONMENT=development
LOG_LEVEL=INFO

# Agent-to-Agent (A2A) Server Configuration
A2A_SERVER_HOST=0.0.0.0
A2A_SERVER_PORT=8080
A2A_SERVER_BASE_URL=http://127.0.0.1:8080

# Remote A2A Agent Endpoints (for distributed agents)
REMOTE_WEATHER_AGENT_URL=http://127.0.0.1:8080/.well-known/agent.json
