# Google Cloud Project & Region
GOOGLE_CLOUD_PROJECT=personal-testing-502307
GOOGLE_CLOUD_REGION=us-central1

# Google Gemini API Key
GOOGLE_API_KEY=your_gemini_api_key_here

# ADK Configuration
ADK_MODEL=gemini-2.5-flash
ADK_ENVIRONMENT=development
LOG_LEVEL=INFO

# Agent-to-Agent (A2A) Server Configuration
A2A_SERVER_HOST=0.0.0.0
A2A_SERVER_PORT=8080
A2A_SERVER_BASE_URL=http://127.0.0.1:8080

# Gemini Enterprise (GE) / Discovery Engine Configuration
GE_APP_ID=gemini-enterprise-17871193_1787119317075
GE_LOCATION=global
GE_ENDPOINT_LOCATION=global
GE_AGENT_NAME=todoist_weather_a2a_agent
GE_AGENT_DISPLAY_NAME=Todoist & Weather A2A Assistant
GE_AUTH_ID=todoist-a2a-oauth
# Set to your Cloud Run HTTPS URL or HTTPS tunnel URL (Gemini Enterprise requires HTTPS)
GE_AGENT_SERVICE_URL=

# Remote A2A Agent Endpoints
REMOTE_WEATHER_AGENT_URL=http://127.0.0.1:8080/.well-known/agent-card.json
REMOTE_TODOIST_AGENT_URL=http://127.0.0.1:8080/.well-known/agent-card.json

# Todoist App OAuth2 Configuration
TODOIST_CLIENT_ID=f1d3a4ec08fb4b60a61679156e2edd92
TODOIST_CLIENT_SECRET=f1d3a4ec08fb4b60a61679156e2edd92
TODOIST_REDIRECT_URI=https://vertexaisearch.cloud.google.com/oauth-redirect
TODOIST_API_TOKEN=
